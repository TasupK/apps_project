# Phase 2 live search provider
PHASE2_SEARCH_PROVIDER=serpapi
SERPAPI_API_KEY=

# Optional: LLM query generation and later extraction steps
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Phase 3/5 LLM prose.
# When disabled, BuyBee uses deterministic rule-based fallback text.
BUYBEE_ENABLE_LLM_EXPLANATIONS=false
BUYBEE_ENABLE_LLM_CHAT=false
